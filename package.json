  },
  "keywords": [
    "handwriting",
    "handwriting-generator",
    "text-to-handwriting",
    "canvas",
    "typesetting",
    "chinese-typesetting",
    "font",
    "pwa",
    "react",
    "vite",
    "手写",
    "手写文稿生成器",
    "文字转手写",
    "字体转手写",
    "手写文稿",
    "离线可用"
